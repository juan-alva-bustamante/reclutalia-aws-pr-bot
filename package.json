{
  "name": "reclutalia-aws-pr-bot",
  "version": "1.0.0",
  "description": "Bot de Telegram para automatizar aprobación y merge de PRs en AWS CodeCommit",
  "main": "dist/main.js",
  "scripts": {
    "validate": "npx tsc --noEmit",
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "dev": "npm run build && tsx src/main.ts",
    "lint": "eslint src/",
    "postinstall": "npx playwright install chromium"
  },
  "keywords": [
    "telegram",
    "aws",
    "codecommit",
    "pr",
    "automation"
  ],
  "license": "PRIVATE",
  "dependencies": {
    "dotenv": "16.6.1",
    "playwright": "1.59.1",
    "telegraf": "4.16.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
