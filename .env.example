# ══════════════════════════════════════════════════════════════
# .env — Bot de PR Autorización (Reclutalia)
# ══════════════════════════════════════════════════════════════
# Copia este archivo como .env y llena los valores.
#   cp .env.example .env
#
# ⚠️  NUNCA subas .env al repositorio (está en .gitignore)
# ══════════════════════════════════════════════════════════════

# ── Telegram ───────────────────────────────────────────────
# Token del bot (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token

# ID del grupo donde opera el bot (número negativo, ej: -1001234567890)
# Tip: envía un mensaje en el grupo y consulta https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Tu ID numérico de Telegram (habla con @userinfobot para obtenerlo)
# El bot te enviará DMs para MFA y alertas de error
TELEGRAM_OWNER_USER_ID=123456789

# (Opcional) ID del topic dentro del grupo donde el bot envía mensajes
# Si no usas topics, déjalo vacío o elimina la línea
TELEGRAM_TOPIC_ID=

# Usernames de Telegram autorizados para aprobar/rechazar PRs
# Sin @, separados por coma, case-insensitive
TELEGRAM_AUTHORIZED_USERS=user1,user2,user3

# ── Perfiles de usuario ────────────────────────────────────
# Mapeo: username_telegram:Nombre Completo:email
# Se usa para atribuir el merge al usuario que aprobó
# Separar múltiples perfiles con coma
USER_PROFILES=user1:Nombre Apellido:correo@empresa.com,user2:Nombre Apellido:correo@empresa.com

# ── AWS Console ────────────────────────────────────────────
# URL de login de tu cuenta AWS
AWS_LOGIN_URL=https://your-account.signin.aws.amazon.com/console

# Alias de la cuenta AWS (aparece en la URL de login)
AWS_ACCOUNT_ID=your-account-alias

# Credenciales del usuario IAM con permisos de aprobación/merge
AWS_USERNAME=your_employee_number
AWS_PASSWORD=your_password

# Nombre y email default del autor del merge (se usa si el usuario que aprueba
# no tiene perfil en USER_PROFILES)
AWS_AUTHOR_NAME=Bot Merge
AWS_AUTHOR_EMAIL=bot@merge.local

# true = browser invisible (producción), false = browser visible (debug)
HEADLESS=true

# ── Roles de AWS (requeridos) ──────────────────────────────
# URLs de switch role. Obtenerlas desde la consola de AWS:
#   → Click en tu usuario → Switch Role → copiar URL
# Formato: https://signin.aws.amazon.com/switchrole?roleName=ROLE&account=ACCOUNT
ROLE_AUTHORIZER_URL=https://signin.aws.amazon.com/switchrole?roleName=devops/Authorizer&account=your-account
ROLE_MANAGER_URL=https://signin.aws.amazon.com/switchrole?roleName=devops/Manager&account=your-account
ROLE_MERGE_URL=https://signin.aws.amazon.com/switchrole?roleName=MergeMaster&account=your-account

# (Opcional) Nombres de los roles para logs. Defaults:
# ROLE_AUTHORIZER_NAME=devops/Authorizer
# ROLE_MANAGER_NAME=devops/Manager
# ROLE_MERGE_NAME=MergeMaster

# ── WebSocket (opcional) ───────────────────────────────────
# Puerto del servidor WS para el widget de monitoreo (default: 9876)
# WS_PORT=9876

# ── AI / Ollama (opcional) ─────────────────────────────────
# Habilita análisis inteligente de diffs antes de la aprobación
# Requiere: Ollama corriendo + modelo descargado (ollama pull qwen2.5-coder:7b)
AI_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=30000
