# ══════════════════════════════════════════════════════════════
# .env — Bot de PR Autorización (Reclutalia)
# ══════════════════════════════════════════════════════════════
# 🔧 PARA EL NUEVO TL:
#   1. Renombra este archivo → .env
#   2. Llena los 5 campos marcados con ← TU DATO
#   3. Borra el archivo aws_session.json (la sesión anterior no te sirve)
#   4. Si quieres IA: instala Ollama + ollama pull qwen2.5-coder:7b
#   5. Listo: npm run start
# ══════════════════════════════════════════════════════════════

# ── Telegram (compartido — NO cambiar) ─────────────────────
TELEGRAM_BOT_TOKEN=8729434587:AAEy1hnflMlHWbD7cLgOgMJ6PvN-MJ0WYPs
TELEGRAM_CHAT_ID=-1003615029025
TELEGRAM_TOPIC_ID=205
TELEGRAM_AUTHORIZED_USERS=juanalva997,JcLievano,gabrielbarba28,el_chambas3000

# ── Telegram (tu dato personal) ────────────────────────────
# Tu ID numérico de Telegram (habla con @userinfobot para obtenerlo)
TELEGRAM_OWNER_USER_ID=                          # ← TU DATO

# ── Perfiles de usuario (compartido) ──────────────────────
# Si tu username de Telegram no está, agrégalo al final con el formato:
#   ,tu_username:Tu Nombre:tu.correo@empresa.com
USER_PROFILES=gabrielbarba28:Gabriel Barba:gabriel.barba@elektra.com.mx,jclievano:Juan Carlos Lievano:juan.lievano@tecnologiaaccionable.mx,el_chambas3000:Felipe Guadarrama:felipe.guadarramah@elektra.com.mx,juanalva997:Juan Alva Bustamante:juan.alva@elektra.com.mx

# ── AWS Console (tus credenciales) ─────────────────────────
AWS_LOGIN_URL=https://upax-reclutalia-dev.signin.aws.amazon.com/console
AWS_ACCOUNT_ID=upax-reclutalia-dev
AWS_USERNAME=                                    # ← TU DATO (número de empleado)
AWS_PASSWORD=                                    # ← TU DATO (contraseña de AWS)
AWS_AUTHOR_NAME=                                 # ← TU DATO (tu nombre completo)
AWS_AUTHOR_EMAIL=                                # ← TU DATO (tu correo corporativo)
HEADLESS=true

# ── Roles de AWS (compartido — NO cambiar) ─────────────────
ROLE_AUTHORIZER_URL=https://signin.aws.amazon.com/switchrole?roleName=devops/Authorizer&account=upax-reclutalia-dev
ROLE_MANAGER_URL=https://signin.aws.amazon.com/switchrole?roleName=devops/Manager&account=upax-reclutalia-dev
ROLE_MERGE_URL=https://signin.aws.amazon.com/switchrole?roleName=MergeMaster&account=upax-reclutalia-dev

# ── AI / Ollama (requiere Ollama instalado en tu máquina) ──
AI_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=60000
